    "le": {
      "speaker": "le",
      "text": [
        {
          "showIf": {
            "flag": "swamp_hostile"
          },
          "text": "«Тогда вода не заплатит вам.»"
        },
        {
          "text": "«Вы пришли по камню и не считали огни. Хорошо. Значит, кто-то из вас читал наши правила или кто-то из вас с болота. Второе хуже для нас, первое хуже для вас.»"
        }
      ],
      "choices": [
        {
          "label": "«Я читал.»",
          "showIf": {
            "notFlag": "swamp_hostile"
          },
          "next": "rules"
        },
        {
          "label": "«Со мной Ресса.»",
          "showIf": {
            "companion": "ressa",
            "notFlag": "swamp_hostile"
          },
          "next": "with_ressa"
        },
        {
          "label": "«Деревня платит вам водой из колодца.»",
          "showIf": {
            "flag": "well_water_omen",
            "notFlag": "swamp_hostile"
          },
          "next": "deal"
        },
        {
          "label": "«[Страх 3] Я не плачу болоту.»",
          "showIf": {
            "notFlag": "swamp_hostile"
          },
          "requires": {
            "rep_fear": 3
          },
          "next": "hostile"
        },
        {
          "label": "Зерно вместо воды. За Рессу.",
          "showIf": {
            "flag": "ressa_water_quest",
            "notFlag": "ressa_water_restored"
          },
          "requires": {
            "item": "grain"
          },
          "reason": "нужно зерно",
          "effects": {
