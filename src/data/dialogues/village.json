    "gate_killed": {
      "speaker": "guard",
      "text": "«Корвина нет. Теперь всякий с дубиной мнит себя Корвином. Вчера трое таких приходили.»"
    },
    "gate_spared": {
      "speaker": "korvin",
      "text": "«Я теперь здесь. Деревня меня кормит, я стерегу дорогу. Как раньше. Как до всего этого.»"
    },
    "gate_legit": {
      "speaker": "taya",
      "text": "«Вы это сделали. Сделали из него закон.»"
    },
    "deserter": {
      "speaker": "deserter",
      "text": "Бывший солдат седьмого поста. Он говорит, что приказ, который возили гонцы, был один и тот же каждые полгода: «держать пост до смены». Смены не было три года. Пост ушёл сам.",
      "effects": {
        "setFlag": "deserter_told"
      },
      "choices": [
        {
          "label": "Вскрыть письмо.",
          "showIf": {
            "notFlag": "letter_opened"
          },
          "effects": {
            "setFlag": "letter_opened",
            "rep": {
              "law": -1
            }
          },
          "next": "letter_read"
        },
        {
          "label": "Не вскрывать.",
          "next": "vornag_react"
        }
      ]
    },
    "letter_read": {
      "speaker": "narrator",
      "text": "«Держать пост до смены.»",
      "next": "vornag_react"
    },
    "well": {
      "speaker": "taya",
      "text": "«Не пейте. Пожалуйста. Потом объясню.»",
      "effects": {
        "setFlag": "well_water_omen"
      }
    },
    "ryzh": {
      "speaker": "taya",
      "text": "«Староста, ваша дочь умерла от воды. Я это тогда сказала. И сейчас говорю.»",
      "lines": [
        {
          "speaker": "ryzh",
          "text": "«Ты сказала это при людях. А люди пьют из колодца. Что мне было делать, сказать им, что я травлю их ради болота?»"
        }
      ],
      "choices": [
        {
          "label": "«Скажи им правду. Я прослежу.»",
          "effects": {
            "setFlag": [
              "well_truth_told",
              "taya_loyal"
            ],
            "rep": {
              "law": 1
            },
            "giveXp": "minor"
          },
          "next": "r_truth"
        },
        {
          "label": "«Молчи. Я поговорю с болотом сам.»",
          "effects": {
            "setFlag": "swamp_deal_kept",
            "rep": {
              "word": 1
            },
            "giveXp": "minor"
          },
          "next": "r_silent"
        },
        {
          "label": "[Страх 2] «Ты будешь платить мне, а не болоту.»",
          "requires": {
            "rep_fear": 2
          },
          "effects": {
            "setFlag": [
              "village_tribute",
              "taya_leaves"
            ],
            "dismiss": "companion_healer",
            "giveXp": "minor"
          },
          "close": true,
          "confirm": "Тая не простит этого и уйдёт из отряда навсегда. Взять с деревни дань?",
          "style": "threat"
        }
      ]
    },
    "r_truth": {
      "speaker": "taya",
      "text": "«Спасибо. Не знаю, чем это кончится. Но спасибо.»"
    },
    "r_silent": {
      "speaker": "taya",
      "text": "«Вы выбрали деревню, а не правду. Я бы, наверное, тоже так выбрала. Только легче от этого не стало.»"
    },
    "ryzh_alone": {
      "speaker": "ryzh",
      "text": "Староста Рыж занят и не хочет говорить с чужими.",
      "choices": [
        {
          "label": "«Болото просит зерно.»",
          "showIf": {
            "flag": "swamp_deal_offered",
            "notFlag": "swamp_deal_kept"
          },
          "effects": {
            "setFlag": "swamp_deal_kept",
            "giveGold": 20,
            "giveXp": "minor"
          },
          "next": "grain"
        },
        {
          "label": "Уйти.",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "grain": {
      "speaker": "ryzh",
      "text": "Рыж обещает платить болоту зерном и отдаёт двадцать монет дани.",
