{
  "id": "swamp",
  "source": "03_ДИАЛОГИ_И_КВЕСТЫ_v0.2, разделы 16.2, 16.3",
  "speakers": {
    "le": {
      "name": "Старейшина Лё",
      "portrait": "portrait_lyo_v2"
    },
    "ressa": {
      "name": "Ресса",
      "portrait": "portrait_swamp_elf_girl"
    },
    "narrator": {
      "name": ""
    }
  },
  "start": [
    {
      "node": "le"
    }
  ],
  "nodes": {
    "le": {
      "speaker": "le",
      "text": [
        {
          "showIf": {
            "flag": "swamp_hostile"
          },
          "text": "«Тогда болото вам ничего не даст и ничего не простит. Уходите.»"
        },
        {
          "text": "«Вы пришли по камню и не считали огни. Хорошо. Значит, либо кто-то из вас читал наши правила, либо кто-то из вас сам с болота. Второе хуже для нас, первое хуже для вас.»"
        }
      ],
      "choices": [
        {
          "label": "«Я читал.»",
          "showIf": {
            "notFlag": "swamp_hostile"
          },
          "next": "rules"
        },
        {
          "label": "«Со мной Ресса.»",
          "showIf": {
            "companion": "ressa",
            "notFlag": [
              "swamp_hostile",
              "ressa_exile_kept",
              "ressa_water_quest"
            ]
          },
          "next": "with_ressa"
        },
        {
          "label": "«Деревня платит вам водой из колодца.»",
          "showIf": {
            "flag": "well_water_omen",
            "notFlag": "swamp_hostile"
          },
          "next": "deal"
        },
        {
          "label": "[Страх 3] «Я не плачу болоту.»",
          "showIf": {
            "notFlag": "swamp_hostile"
          },
          "requires": {
            "rep_fear": 3
          },
          "next": "hostile"
        },
        {
          "label": "«Зерно вместо воды. За Рессу.»",
          "showIf": {
            "flag": "ressa_water_quest",
            "notFlag": [
              "ressa_water_restored",
              "swamp_hostile"
            ]
          },
          "requires": {
            "item": "grain"
          },
          "reason": "нужно зерно",
          "effects": {
            "takeItem": "grain",
            "setFlag": "ressa_water_restored",
            "giveXp": 30
          },
          "next": "water_back"
        },
        {
          "label": "«Что вы меняете?»",
          "showIf": {
            "notFlag": "swamp_hostile"
          },
          "effects": {
            "openShop": "le"
          },
          "close": true
        },
        {
          "label": "Уйти.",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "rules": {
      "speaker": "le",
      "text": "«Тогда знаете и третье правило: за ответ платят. Спрашивайте.»",
      "choices": [
        {
          "label": "[10 монет] «Что такое Печать для вас?»",
          "showIf": {
            "notFlag": "swamp_seal_is_key"
          },
          "requires": {
            "gold": 10
          },
          "effects": {
            "cost": 10
          },
          "next": "q_seal"
        },
        {
          "label": "[10 монет] «Кто такой Гаст?»",
          "showIf": {
            "notFlag": "gast_reads_obelisk"
          },
          "requires": {
            "gold": 10
          },
          "effects": {
            "cost": 10
          },
          "next": "q_gast"
        },
        {
          "label": "[10 монет] «Почему деревня болеет?»",
          "showIf": {
            "notFlag": "well_truth_swamp"
          },
          "requires": {
            "gold": 10
          },
          "effects": {
            "cost": 10
          },
          "next": "q_well"
        },
        {
          "label": "«Хватит вопросов.»",
          "style": "retreat",
          "next": "le"
        }
      ]
    },
    "q_seal": {
      "speaker": "le",
      "text": "«Печать это ключ. Он был наш, пока люди не стали носить его на пальце, как украшение. Ключ отпирает дверь, а дверь эта не у нас: она в подвале под вашей таверной.»",
      "effects": {
        "setFlag": "swamp_seal_is_key"
      },
      "next": "rules"
    },
    "q_gast": {
      "speaker": "le",
      "text": "«Человек, который приходит к нашему обелиску и читает с него имена вслух. Обелиск ставили, чтобы помнить умерших молча. Гаст читает их, и живые забывают тех, кого он назвал.»",
      "effects": {
        "setFlag": "gast_reads_obelisk"
      },
      "next": "rules"
    },
    "q_well": {
      "speaker": "le",
      "text": "«Потому что староста платит нам не тем. Мы просили зерно, а он даёт воду. Колодезную воду болоту отдавать нельзя: болото её вернёт, но уже отравленной. От неё деревня и болеет.»",
      "effects": {
        "setFlag": "well_truth_swamp"
      },
      "next": "rules"
    },
    "deal": {
      "speaker": "le",
      "text": "«Скажите старосте: зерно, не вода. Он знает цену зерна и боится её. Если он заплатит зерном, колодец очистится к весне. Если нет, мы придём за водой сами.»",
      "effects": {
        "setFlag": "swamp_deal_offered"
      },
      "next": "le"
    },
    "hostile": {
      "speaker": "le",
      "text": "«Тогда болото вам ничего не даст и ничего не простит. Уходите.»",
      "effects": {
        "setFlag": "swamp_hostile",
        "rep": {
          "fear": 1
        }
      }
    },
    "with_ressa": {
      "speaker": "le",
      "text": "«Вы привели изгнанницу. Значит, вы за неё отвечаете. Чего вы хотите?»",
      "choices": [
        {
          "label": "«Верни ей воду.»",
          "next": "ressa_water"
        },
        {
          "label": "«Она со мной, и этого хватит.»",
          "effects": {
            "setFlag": "ressa_exile_kept",
            "rep": {
              "word": 1
            }
          },
          "close": true
        }
      ]
    },
    "ressa_water": {
      "speaker": "le",
      "text": "«Просто так я вернуть ей воду не могу. Принесите болоту мешок зерна за неё, раз староста не платит. Тогда болото снова примет Рессу.»",
      "effects": {
        "setFlag": "ressa_water_quest"
      }
    },
    "ressa": {
      "speaker": "ressa",
      "text": "«Вы не считали огни. Это я их зажигаю. Чтобы такие, как вы, считали и уходили. Вы не ушли.»",
      "choices": [
        {
          "label": "«Почему ты одна?»",
          "next": "r_why"
        },
        {
          "label": "«Идём со мной.»",
          "next": "r_join"
        },
        {
          "label": "«Что ты умеешь?»",
          "next": "r_can"
        },
        {
          "label": "Уйти.",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "r_why": {
      "speaker": "ressa",
      "text": "«Я лечила людей, как велит имперская бумага: всех подряд. А болото чужих не лечит, вода тут своя. Я считала, что человек есть человек. Меня и выставили.»",
      "next": "ressa"
    },
    "r_join": {
      "speaker": "ressa",
      "text": "«Куда? К людям? Люди меня не хотят. К болоту? Оно меня не пьёт. Ладно. Пойду с тобой. С тобой я хотя бы ещё не пробовала.»",
      "effects": {
        "setFlag": "ressa_recruited",
        "recruit": "ressa"
      }
    },
    "r_can": {
      "speaker": "ressa",
      "text": "«Лечить так, что потом больно мне. Бить так, что потом больно всем. Выбирай, что нужнее. Наполовину я не умею.»",
      "next": "ressa"
    },
    "lights": {
      "speaker": "narrator",
      "text": "Над водой плавают огни. Правило болота: их не считают. Кто сосчитает, за тем приходят мавки.",
      "choices": [
        {
          "label": "Посчитать огни.",
          "effects": {
            "setFlag": "mavki_lights_woken"
          },
          "startBattle": {
            "battleId": "swamp_lights"
          }
        },
        {
          "label": "Не считать.",
          "effects": {
            "setFlag": "lights_not_counted"
          },
          "close": true
        }
      ]
    },
    "water_back": {
      "speaker": "le",
      "text": "Лё опускает руку в воду и долго молчит. Потом кивает Рессе.",
      "next": "le"
    }
  }
}
