        {
          "label": "Простить дань.",
          "effects": {
            "cost": 20,
            "rep": {
              "word": 1
            }
          },
          "close": true
        },
        {
          "label": "Взять.",
          "close": true
        }
      ]
    },
    "chapel": {
      "speaker": "narrator",
      "text": "Свет в часовне. Внутри Хранитель свечей и Чтецы читают имена из приходской книги вслух.",
      "choices": [
        {
          "label": "[Тайная грамота] Прочесть книгу раньше них и вырвать страницу с живыми.",
          "requires": {
            "trait": "secret_literacy"
          },
          "effects": {
            "setFlag": [
              "chapel_peaceful",
              "chapel_cult_defeated_peace"
            ],
            "giveXp": "battle:chapel_cult"
          },
          "next": "chapel_holt"
        },
        {
          "label": "[Страх 3] Заставить их читать имена людей Корвина.",
          "requires": {
            "rep_fear": 3
          },
          "effects": {
            "setFlag": "cult_turned",
            "giveXp": "battle:chapel_cult"
          },
          "close": true
