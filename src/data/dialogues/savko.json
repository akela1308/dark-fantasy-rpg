  "nodes": {
    "root": {
      "speaker": "savko",
      "text": "«Не стой в дверях... Сквозняк несёт с севера. А с севера редко несёт доброе. Слыхал про запечатанный подвал?»",
      "effects": {
        "setFlag": "savko_met"
      },
      "choices": [
        {
          "label": "«Ты там был?»",
          "next": "was"
        },
        {
          "label": "«Почему ты пьёшь?»",
          "next": "why"
        },
        {
          "label": "[3 монеты] Выпить с ним.",
          "showIf": {
            "flag": "savko_believed",
            "notFlag": [
              "savko_key_given",
              "savko_gone"
            ]
          },
          "requires": {
            "gold": 3
          },
          "effects": {
            "cost": 3,
            "counter": "savko_drinks"
          },
          "next": "drink"
        },
        {
          "label": "«Тая, поговори с ним.»",
          "showIf": {
            "flag": "savko_believed",
            "notFlag": [
              "savko_key_given",
              "savko_gone"
            ]
          },
          "requires": {
            "companion": "companion_healer"
          },
          "next": "taya_talk"
        },
        {
          "label": "[Страх 2] «Где ключ от подвала?»",
          "showIf": {
            "flag": "savko_believed",
            "notFlag": [
              "savko_key_given",
              "savko_gone"
            ]
          },
          "requires": {
            "rep_fear": 2
          },
          "next": "threat"
        },
        {
          "label": "«Не сейчас.»",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "was": {
      "speaker": "savko",
      "text": "«Был? Нет. Бывают в гостях. А я держал фонарь, когда дверь запирали. Чёрное железо. Холодная ручка. И тишина, которая ждала, пока мы назовём имена.»",
      "choices": [
        {
          "label": "«Что за дверью?»",
          "next": "behind"
        }
      ]
    },
    "behind": {
      "speaker": "savko",
      "text": "«Не знаю. И потому ещё жив. Знаю только: если услышишь слово „Печать“, не отвечай сразу. Сначала вспомни своё имя.»",
      "choices": [
        {
          "label": "«Запомню.»",
          "effects": {
            "setFlag": "savko_believed"
          },
          "close": true
        }
      ]
    },
    "drink": {
      "goto": [
        {
          "showIf": {
            "flag": "cnt_savko_drinks_3"
          },
          "node": "key_drunk"
        },
        {
          "node": "drink_more"
        }
      ]
    },
    "drink_more": {
      "speaker": "savko",
      "text": "Савко пьёт молча и смотрит на север.",
      "effects": {
        "giveXp": "quest"
      }
    },
    "key_drunk": {
      "speaker": "savko",
      "text": "«Ключ у меня. Во сне. То есть вот.» «Не стало. То есть он стал другим. Дверь бросил, дорогу взял. Корвином звали. Зовут.»",
      "effects": {
        "setFlag": [
          "savko_key_given",
          "korvin_was_warden",
          "cellar_open"
        ],
        "giveItem": "savko_key",
        "giveXp": "quest"
      }
    },
    "taya_talk": {
      "speaker": "savko",
      "text": "«Ей отдам. У неё руки тёплые, она не оттуда.»",
      "effects": {
        "setFlag": [
          "savko_key_given",
          "cellar_open"
        ],
        "giveItem": "savko_key",
        "rep": {
          "word": 1
        },
        "giveXp": "quest"
      },
      "lines": [
        {
          "speaker": "taya",
          "text": "«Он пьян, но не пуст. У таких страх пахнет иначе.»"
        }
      ]
    },
    "threat": {
      "speaker": "savko",
      "text": "Савко показывает люк за дровами и уходит в ночь. Ключа он не отдал.",
      "effects": {
        "setFlag": [
          "savko_gone",
          "vorn_wary",
          "hatch_known"
        ],
        "rep": {
          "fear": 1
        }
      },
      "goto": [
        {
          "showIf": {
            "any": [
              {
                "companion": "companion_brawler"
              },
              {
                "flag": "brawler_bonebreaker"
              }
            ]
          },
          "node": "hatch_broken"
        }
      ]
    },
    "hatch_broken": {
      "speaker": "savko",
      "text": "Ворнаг ломает замок люка.",
      "effects": {
        "setFlag": "cellar_open"
      }
    },
    "korvin_dead": {
      "speaker": "savko",
      "text": "«Убили десятника? Он мне когда-то фонарь держал. Да, он. Молодой был. Ну, выпьем. За фонарь.»",
      "effects": {
        "setFlag": "savko_korvin_toast"
      },
      "next": "root"
    },
    "reader_alive": {
      "speaker": "savko",
      "text": "«Ты ходил трактом? Там таблички. Ты читал?» «Значит, он ещё читает. Хорошо. Пусть.»",
      "effects": {
        "setFlag": "savko_reader_told"
      },
      "next": "root"
    },
    "reader_dead": {
      "speaker": "savko",
      "text": "«Ты ходил трактом? Там таблички. Ты читал?» «Теперь не прочтёшь.»",
      "effects": {
        "setFlag": [
          "savko_reader_told",
          "savko_gone"
        ]
      }
    },
    "why": {
      "speaker": "savko",
      "text": "«Чтобы не помнить, как запирали ту дверь. Не помогает: помню. Зато руки больше не дрожат.»",
      "choices": [
        {
          "label": "«Какую дверь?»",
          "next": "was"
        },
        {
          "label": "«Не буду мешать.»",
          "style": "retreat",
          "close": true
        }
      ]
    }
  }
}