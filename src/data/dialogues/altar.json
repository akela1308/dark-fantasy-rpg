      "portrait": "portrait_companion_brawler"
    },
    "holt": {
      "name": "Хольт",
      "portrait": "portrait_holt"
    }
  },
  "start": [
    {
      "showIf": {
        "any": [
          {
            "flag": "seal_taken"
          },
          {
            "flag": "seal_left"
          }
        ]
      },
      "node": "after"
    },
    {
      "showIf": {
        "any": [
          {
            "flag": "altar_shadows_defeated"
          },
          {
            "flag": "altar_peaceful"
          }
        ]
      },
      "node": "ring"
    },
    {
      "node": "stones"
    }
  ],
  "nodes": {
    "stones": {
      "speaker": "narrator",
      "text": "Три камня. На одном знак, похожий на печать письма. На втором имя, которое не читается дважды подряд. Третий пустой. Между камнями кольцо из чёрного металла на плоском камне.",
      "choices": [
        {
          "label": "Обойти камни: знак, имя, пустота.",
          "requires": {
            "flag": "rowan_seal_hint"
          },
          "reason": "порядок знает Рован",
          "effects": {
            "setFlag": "altar_peaceful",
            "giveXp": "battle:altar_shadows"
          },
          "next": "ring"
        },
        {
          "label": "Подойти к кольцу напрямую.",
          "style": "attack",
          "startBattle": {
            "battleId": "altar_shadows",
            "onWin": "ring"
          }
        },
        {
          "label": "Уйти.",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "ring": {
      "speaker": "narrator",
      "text": "Кольцо из чёрного металла лежит на плоском камне.",
      "lines": [
        {
          "showIf": {
            "flag": "rowan_joins_to_altar"
          },
          "speaker": "narrator",
          "text": "Рован стоит у края и не подходит."
        }
      ],
      "choices": [
        {
          "label": "Надеть.",
          "effects": {
            "setFlag": [
              "seal_taken",
              "seal_worn",
              "seal_name_debt"
            ]
          },
          "next": "worn"
        },
        {
          "label": "Взять, не надевая.",
          "effects": {
            "setFlag": "seal_taken"
          },
          "next": "taken"
        },
        {
          "label": "Оставить.",
          "effects": {
            "setFlag": "seal_left"
          },
          "next": "left"
        },
        {
          "label": "Отдать Ровану.",
          "showIf": {
            "flag": "rowan_joins_to_altar",
            "notFlag": "rowan_already_paid"
          },
          "next": "rowan"
        }
      ]
    },
    "worn": {
      "speaker": "narrator",
      "text": "«Холод. Не в пальце, в затылке. Вы помните, что должны что-то вспомнить, и не помните что.»",
      "next": "holt_check"
    },
    "taken": {
      "speaker": "narrator",
      "text": "Кольцо лежит в кармане и греет. Платить пока не нужно. Пока.",
      "next": "taya_check"
    },
    "taya_check": {
      "goto": [
        {
          "showIf": {
            "companion": "companion_healer"
          },
          "node": "taya_warn"
        }
      ]
    },
    "taya_warn": {
      "speaker": "taya",
      "text": "«У вас пальцы холодные. Как у Савко. Я такое один раз видела, у него. Вроде лихорадки, только наоборот: человек не горит, а стынет.»",
      "effects": {
        "setFlag": "taya_seal_warning"
      }
    },
    "left": {
      "goto": [
        {
          "showIf": {
            "flag": "rowan_joins_to_altar"
          },
          "node": "rowan_leaves"
        },
        {
          "node": "stone_voice"
        }
      ]
    },
    "rowan_leaves": {
      "speaker": "rowan",
      "text": "«Вы первый, кто не взял. Все остальные брали.»",
      "effects": {
        "setFlag": "rowan_gone"
      }
    },
    "stone_voice": {
      "speaker": "stone",
      "text": "«Тогда назови имя, которое оставишь вместо кольца.»",
      "choices": [
        {
          "label": "Назвать своё.",
          "effects": {
            "setFlag": "hero_name_spoken"
          },
          "close": true
        },
        {
          "label": "Назвать имя спутника.",
          "effects": {
            "setFlag": "companion_named_to_stone"
          },
          "close": true
        }
      ]
    },
    "rowan": {
      "speaker": "rowan",
      "text": "«Меня оно не узнаёт. Я своё уже заплатил. Тем же, чем платят все.»",
      "effects": {
        "setFlag": "rowan_already_paid"
      },
      "next": "ring"
    },
    "after": {
      "speaker": "narrator",
      "text": "Три камня молчат."
    },
    "holt_check": {
      "goto": [
        {
          "showIf": {
            "companion": "holt",
            "notFlag": "holt_sister_hint"
          },
          "node": "holt_leaves"
        },
        {
          "showIf": {
            "companion": "holt"
          },
          "node": "holt_stays"
        },
        {
          "node": "taya_check"
        }
      ]
    },
    "holt_leaves": {
      "speaker": "narrator",
      "text": "Хольт молча убирает трубку и уходит в лес.",
      "effects": {
        "setFlag": "holt_left",
        "dismissForever": "holt"
      },
      "next": "taya_check"
    },
    "holt_stays": {
      "speaker": "holt",
      "text": "«Ты знаешь, что она забирает. Значит, решил. А того, кто решил, я не отговариваю.»",
      "next": "taya_check"
    }
  }
}