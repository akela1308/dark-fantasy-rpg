    "vornag_loyal": {
      "speaker": "vornag",
      "text": "«Я слышал. Пост бросили, значит, и гонца послали в никуда. Мне заплатили, чтоб я охранял человека, которого по бумаге отправили умирать. Деньги я отработал. Дальше пойду уже даром, по своей воле. Пойду.»",
      "effects": {
        "setFlag": "wornag_loyal"
      }
    },
    "vornag_leaves": {
      "speaker": "vornag",
      "text": "«Я был с тобой до деревни. Дальше ищи себе другой щит. Видел я, как ты смотришь на тех, кто уже лежит.»",
      "effects": {
        "setFlag": "wornag_leaves",
        "dismissForever": "companion_brawler"
      }
    },
    "mirko": {
      "speaker": "mirko",
      "text": "Юноша в наспех подогнанной кольчуге сжимает меч, которым едва умеет пользоваться. «Я записался в ополчение. Ворота, дозор, всё как положено. Только защищать уже почти некого.»",
      "choices": [
        {
          "label": "«Почему люди уходят?»",
          "next": "mirko_why"
        },
        {
          "label": "«Тебе бы уйти отсюда.»",
          "next": "mirko_go"
        },
        {
          "label": "«Идём с нами.»",
          "showIf": {
            "any": [
              {
                "flag": "chapel_peaceful"
              },
              {
                "flag": "chapel_cult_defeated"
              },
              {
                "flag": "cult_turned"
              }
            ],
            "notFlag": "mirko_recruited"
          },
          "next": "mirko_join"
        },
        {
          "label": "«Держись, парень.»",
          "effects": {
            "setFlag": "mirko_encouraged"
          },
          "close": true
        }
      ]
    },
    "mirko_why": {
      "speaker": "mirko",
      "text": "«Земля уже не родит, как раньше. Скотина болеет. А по ночам с той стороны леса тянет гарью, хотя ничего не горит. Староста молчит и жжёт свечи у запечатанной двери.»",
      "choices": [
        {
          "label": "«Запечатанной двери?»",
          "effects": {
            "setFlag": [
              "village_sealed_door",
              "village_rumor_known"
            ]
          },
          "close": true
        }
      ]
    },
    "mirko_go": {
      "speaker": "mirko",
      "text": "«И куда? На дорогу, где люди пропадают отрядами? Нет уж. Лучше стоять у своих ворот. Тут хоть знаешь, за что держишь меч.»",
      "choices": [
        {
          "label": "«Как знаешь.»",
          "close": true
        }
      ]
    },
    "mirko_join": {
      "speaker": "mirko",
      "text": "«Пойду. Тут и стеречь-то уже почти нечего.»",
      "effects": {
        "setFlag": "mirko_recruited",
        "recruit": "mirko"
      }
    },
    "bran": {
      "speaker": "bran",
      "text": "Лучник на посту не сводит глаз с дороги за твоей спиной. «Пришёл один? Тогда ты либо смелый, либо не знаешь, что творится на трактах. И то и другое плохо.»",
      "choices": [
        {
          "label": "«Что творится на трактах?»",
          "next": "bran_road"
        },
        {
          "label": "«Я не один.»",
          "next": "bran_notalone"
        },
        {
          "label": "«Идём с нами. Деревне больше никто не угрожает.»",
          "showIf": {
            "notFlag": "bran_recruited"
          },
          "requires": {
            "all": [
              {
                "any": [
                  {
                    "flag": "chapel_peaceful"
                  },
                  {
                    "flag": "chapel_cult_defeated"
                  }
                ]
              },
              {
                "any": [
                  {
                    "flag": "bandit_commander_killed"
                  },
                  {
                    "flag": "korvin_witness"
                  }
                ]
              }
            ]
          },
          "reason": "деревня ещё под угрозой",
          "next": "bran_join"
        },
        {
          "label": "Промолчать.",
          "close": true
        }
      ]
    },
    "bran_road": {
      "speaker": "bran",
      "text": "«Разбойники держат дорогу крепче закона. А теперь ещё люди с печатями появились. Тихие, вежливые. А после них кто-нибудь обязательно забывает своё имя.»",
      "choices": [
        {
          "label": "«Люди с печатями?»",
          "effects": {
            "setFlag": [
              "seal_people_rumor",
              "village_rumor_known"
            ]
          },
          "close": true
        }
      ]
    },
    "bran_notalone": {
      "speaker": "bran",
      "text": "«Тогда держи своих при себе. Здесь пропадают целыми отрядами, и никто потом даже не ищет, кто виноват.»",
      "choices": [
        {
          "label": "Уйти.",
          "close": true
        }
      ]
    },
    "bran_join": {
      "speaker": "narrator",
      "text": "Бран снимает с плеча лук и встаёт рядом.",
      "effects": {
        "setFlag": "bran_recruited",
        "recruit": "bran"
      }
    }
  }
