{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mortis",
  "version": "0.1.0",
  "identifier": "com.akela.mortis",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5173/dark-fantasy-rpg/",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Mortis",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}