    }
  ],
  "nodes": {
    "root": {
      "speaker": "mira",
      "text": "«Сапоги у двери обстучите. Вчера один такой „ненадолго“ оставил пол-леса под столом.»",
      "effects": {
        "setFlag": "mira_met"
      },
      "choices": [
        {
          "label": "«Видела чужих в плащах?»",
          "next": "cloaks"
        },
        {
          "label": "«Чью грязь ты вчера отмывала?»",
          "next": "mud"
        },
        {
          "label": "«Не буду мешать.»",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "cloaks": {
      "speaker": "mira",
      "text": "«Были двое. Не ели, не пили, сидели спиной к стене. Кто в дороге не ест, тот либо очень спешит, либо чего-то боится.»",
      "effects": {
        "setFlag": "mira_cloaked_men_seen"
      },
      "lines": [
        {
          "showIf": {
            "companion": "holt"
          },
          "speaker": "holt",
          "text": "«Это они. Мира, а после них никто в зале ничего не забыл? Слово, имя?»"
        },
        {
          "showIf": {
            "companion": "holt"
          },
          "speaker": "mira",
          "text": "«Савко забыл, как меня зовут. На один вечер.»"
        }
      ],
      "choices": [
        {
          "label": "«С кем они говорили?»",
          "next": "mud"
        }
      ]
    },
    "mud": {
      "speaker": "mira",
      "text": "«Двоих в плащах. На сапогах болотная жижа пополам с хвоей, через лес от болот шли. Говорили со странником. Или он с ними, не разберёшь, кто кого ждал.»",
      "effects": {
        "setFlag": "mira_cloaked_men_seen"
      },
      "choices": [
        {
          "label": "«Я никому не скажу, что слышал это от тебя.»",
          "showIf": {
            "notFlag": [
              "mira_source_protected",
              "mira_source_betrayed"
            ]
          },
          "effects": {
            "setFlag": [
              "mira_source_protected",
              "mira_trust"
            ],
            "rep": {
              "word": 1
            },
            "giveXp": 15
          },
          "next": "smart"
        },
        {
          "label": "«Ворн должен это знать.»",
          "showIf": {
            "notFlag": [
              "mira_source_protected",
              "mira_source_betrayed"
            ]
          },
          "effects": {
            "setFlag": "mira_source_betrayed",
            "rep": {
              "word": -1
            },
            "giveXp": 15
          },
          "close": true
        },
        {
          "label": "«Понятно.»",
          "showIf": {
            "any": [
              {
                "flag": "mira_source_protected"
              },
              {
                "flag": "mira_source_betrayed"
              }
            ]
          },
          "close": true
        }
      ]
    },
    "smart": {
      "speaker": "mira",
      "text": "«Вот это разумно. Только потом не забудьте, что обещали.»",
      "choices": [
        {
          "label": "«Спасибо, Мира.»",
          "close": true
        }
      ]
    },
    "taya": {
      "speaker": "mira",
      "text": "«Вы из Придорожного. Я помню вас по ярмарке. Вы тогда лечили старостину дочь.»",
      "lines": [
        {
          "speaker": "taya",
          "text": "«Лечила.»"
        },
        {
          "speaker": "mira",
          "text": "«Не вылечили.»"
        }
      ],
      "effects": {
        "setFlag": "taya_mira_tension"
      },
      "next": "root"
    },
    "warn": {
      "speaker": "mira",
      "text": "«Когда вы вошли, тут уже сидел один из лесных. Не пил, только слушал. Такие потом возвращаются, и не за пивом.»",
      "effects": {
        "setFlag": "mira_warned"
      },
      "choices": [
        {
          "label": "«Когда это было?»",
          "next": "root"
        }
      ]
    },
    "killed": {
      "speaker": "mira",
      "text": "«Люди уже говорят, что вы убили Корвина. И что теперь можно никого не бояться. Вот второму я бы не верила.»",
      "effects": {
        "setFlag": "mira_heard_killed"
      },
      "choices": [
        {
          "label": "«Посмотрим.»",
          "next": "root"
        }
      ]
    },
    "gast": {
      "speaker": "mira",
      "text": "Мира наклоняется ближе и называет имя того, кто водит людей в плащах: Гаст.",
      "effects": {
        "setFlag": "cloaks_leader_named"
      },
      "next": "root"
    },
    "cold": {
      "speaker": "mira",
      "text": "Мира отвечает односложно и отворачивается к ведру.",
      "choices": [
        {
          "label": "«Корвин любит тех, кто платит?»",
          "showIf": {
            "flag": "bandit_paid"
          },
          "next": "paid"
        },
        {
          "label": "Уйти.",
          "style": "retreat",
          "close": true
        }
      ]
    },
    "paid": {
      "speaker": "mira",
      "text": "«Любит. Пока платят. А потом ему очень интересно, куда они дальше пошли.»",
      "choices": [
        {
          "label": "«Понятно.»",
          "close": true
        }
      ]
    }
  }
}